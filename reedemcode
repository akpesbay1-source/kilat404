<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Redeem Bonus</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Segoe UI', Arial, sans-serif;
}

body{
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    background:
        radial-gradient(circle at top left,rgba(255,215,0,.25),transparent 35%),
        radial-gradient(circle at bottom right,rgba(255,140,0,.20),transparent 35%),
        linear-gradient(135deg,#020202,#111,#000);
    color:white;
    overflow:hidden;
}

.card{
    width:92%;
    max-width:420px;
    padding:32px 26px;
    border-radius:28px;
    background:rgba(0,0,0,.88);
    border:1px solid rgba(255,215,0,.28);
    box-shadow:0 0 45px rgba(255,215,0,.22);
    text-align:center;
    animation:cardIn .7s ease;
}

@keyframes cardIn{
    from{opacity:0;transform:scale(.9) translateY(20px);}
    to{opacity:1;transform:scale(1) translateY(0);}
}

.logo{
    margin-bottom:14px;
}

.logo img{
    width:280px;
    max-width:100%;
    height:auto;
    filter:
        drop-shadow(0 0 15px rgba(255,215,0,.6))
        drop-shadow(0 0 35px rgba(255,215,0,.4));
    animation:logoFloat 3s ease-in-out infinite;
}

@keyframes logoFloat{
    0%,100%{transform:translateY(0);}
    50%{transform:translateY(-6px);}
}

.badge{
    display:inline-block;
    padding:8px 18px;
    border-radius:30px;
    background:rgba(255,215,0,.13);
    color:#ffd700;
    font-size:12px;
    letter-spacing:1.4px;
    margin-bottom:16px;
}

h1{
    color:#ffd700;
    font-size:31px;
    margin-bottom:10px;
    text-shadow:0 0 18px rgba(255,215,0,.8);
}

.desc{
    color:#ccc;
    font-size:14px;
    line-height:1.6;
    margin-bottom:24px;
}

input{
    width:100%;
    height:54px;
    margin-bottom:14px;
    border-radius:16px;
    border:1px solid rgba(255,215,0,.25);
    outline:none;
    background:#101010;
    color:#ffd700;
    text-align:center;
    font-size:15px;
    font-weight:700;
}

input::placeholder{
    color:#777;
}

input:focus{
    border-color:#ffd700;
    box-shadow:0 0 18px rgba(255,215,0,.4);
}

button{
    width:100%;
    height:54px;
    border:none;
    border-radius:16px;
    background:linear-gradient(135deg,#ffe45c,#ffb000,#ff8c00);
    color:#000;
    font-size:16px;
    font-weight:900;
    cursor:pointer;
    transition:.3s;
}

button:hover{
    transform:translateY(-2px);
    box-shadow:0 0 28px rgba(255,215,0,.55);
}

.message{
    margin-top:16px;
    font-size:14px;
    font-weight:700;
}

.error{
    color:#ff4b4b;
}

.small{
    margin-top:18px;
    font-size:11px;
    color:#888;
}

.loading-wrap{
    padding:24px 5px;
}

.spinner{
    width:82px;
    height:82px;
    margin:0 auto 22px;
    border-radius:50%;
    border:7px solid rgba(255,215,0,.12);
    border-top:7px solid #ffd700;
    animation:spin 1s linear infinite;
    box-shadow:0 0 25px rgba(255,215,0,.35);
}

@keyframes spin{
    to{transform:rotate(360deg);}
}

.loading-title{
    color:#ffd700;
    font-size:24px;
    font-weight:900;
    margin-bottom:10px;
}

.loading-text{
    color:#ddd;
    font-size:14px;
    line-height:1.5;
}

.progress{
    width:100%;
    height:9px;
    background:#151515;
    border-radius:30px;
    margin-top:24px;
    overflow:hidden;
    border:1px solid rgba(255,215,0,.15);
}

.progress-bar{
    height:100%;
    width:0%;
    background:linear-gradient(90deg,#ffd700,#ffae00);
    animation:progressMove 2.8s forwards;
}

@keyframes progressMove{
    from{width:0%;}
    to{width:100%;}
}

.success-icon{
    width:88px;
    height:88px;
    margin:0 auto 20px;
    border-radius:50%;
    background:rgba(0,255,136,.12);
    border:2px solid #00ff88;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:44px;
    color:#00ff88;
    animation:pop .6s ease;
}

@keyframes pop{
    0%{transform:scale(.3);opacity:0;}
    70%{transform:scale(1.15);}
    100%{transform:scale(1);opacity:1;}
}

.step-box{
    margin-top:20px;
    padding:18px;
    border-radius:18px;
    background:rgba(255,215,0,.08);
    border:1px solid rgba(255,215,0,.2);
    text-align:left;
}

.step-box h3{
    color:#ffd700;
    text-align:center;
    margin-bottom:12px;
    font-size:16px;
}

.step-box ol{
    padding-left:20px;
    color:#e0e0e0;
    font-size:14px;
    line-height:1.8;
}
</style>
</head>

<body>

<div class="card" id="card">

    <div class="logo">
        <img src="https://sga-cdn-hxg6b2d7ctb2c0eu.z02.azurefd.net/agent-websites/326/medialibrary/images/326_d403d3a3233245cb950597bd295b1f98.webp" alt="Logo">
    </div>

    <h1>REDEEM CODE</h1>

    <p class="desc">
        Masukkan username dan kode redeem untuk membuka akses bonus
    </p>

    <input type="text" id="username" placeholder="MASUKKAN USERNAME">
    <input type="text" id="code" placeholder="MASUKKAN KODE REDEEM">

    <button onclick="redeemCode()">KLAIM BONUS</button>

    <div class="message" id="message"></div>

    <div class="small">
        Pastikan username dan kode sudah benar
    </div>

</div>

<script>
function redeemCode(){

    const username = document.getElementById("username").value.trim();
    const code = document.getElementById("code").value.trim();
    const message = document.getElementById("message");
    const card = document.getElementById("card");

    const validCode = "BONUS1000";

    if(username === "" || code === ""){
        message.className = "message error";
        message.innerHTML = "Username dan kode wajib diisi.";
        return;
    }

    if(code.toUpperCase() !== validCode){
        message.className = "message error";
        message.innerHTML = "Kode redeem tidak valid.";
        return;
    }

    card.innerHTML = `
        <div class="logo">
            <img src="https://sga-cdn-hxg6b2d7ctb2c0eu.z02.azurefd.net/agent-websites/326/medialibrary/images/326_d403d3a3233245cb950597bd295b1f98.webp" alt="Logo">
        </div>

        <div class="loading-wrap">
            <div class="spinner"></div>

            <div class="loading-title">
                MEMPROSES...
            </div>

            <div class="loading-text">
                Sistem sedang memverifikasi username dan kode redeem kamu.
            </div>

            <div class="progress">
                <div class="progress-bar"></div>
            </div>

            <div class="small">
                Proses klaim sedang berjalan.
            </div>
        </div>
    `;

    setTimeout(() => {
        card.innerHTML = `
            <div class="logo">
                <img src="https://sga-cdn-hxg6b2d7ctb2c0eu.z02.azurefd.net/agent-websites/326/medialibrary/images/326_d403d3a3233245cb950597bd295b1f98.webp" alt="Logo">
            </div>

            <div class="success-icon">✓</div>

            <div class="badge">KLAIM BONUS</div>

            <h1>BERHASIL!</h1>

            <p class="desc">
                Halo <b>${username}</b>, kode redeem kamu berhasil diproses.
            </p>

            <div class="step-box">
                <h3>CARA MENCAIRKAN BONUS</h3>
                <ol>
                    <li>Login menggunakan username yang sama.</li>
                    <li>Lakukan deposit minimal 35rb menggunakan QRIS</li>
                    <li>Bonus akan diproses otomatis setelah transaksi berhasil.</li>
                    <li>Pastikan data akun sudah benar sebelum melanjutkan.</li>
                </ol>
            </div>

            <br>

            <button onclick="lanjutDeposit()">
                LANJUTKAN
            </button>

            <div class="small">
                Bonus mengikuti syarat dan ketentuan yang berlaku.
            </div>
        `;
    }, 3000);
}

function lanjutDeposit(){
    window.location.href = "https://dub.sh/kilat404-qris";
}
</script>

</body>
</html>
